      "text": "{\n  \"id\":       str          # id du LLM, sinon payload[\"id\"]\n  \"analyse\":  str | None   # raisonnement libre du modèle\n  \"reglesMetier\": {         # ★ lecture COMPARÉE aux annotations\n      \"codeTypeOperation\": str | None,\n      \"operations\": [op, op, …]  }\n  \"lectureJuridique\": {     # lecture juridique propre au modèle\n      \"codeTypeOperation\": str | None,\n      \"operations\": [op, op, …]  }\n  \"retenu\":   bool         # restructuration ? (déduit si absent)\n}",
